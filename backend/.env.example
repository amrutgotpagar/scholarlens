# Copy to .env and fill in. docker-compose.yml sets DATABASE_URL itself; leave it unset
# here unless you're running the backend outside docker-compose.

# Pick one: "openai" (paid, best quality), "ollama" (free, local — docker-compose starts
# it for you), or "nvidia" (free NVIDIA NIM hosted API, needs a free API key).
LLM_PROVIDER=ollama

OPENAI_API_KEY=
NVIDIA_API_KEY=

# Supabase Auth — Project Settings -> API. Only needed if you're testing auth locally
# against a real Supabase project rather than stubbing it out.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# AWS S3 for uploaded PDFs (presigned URLs). Standard boto3 env vars.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-north-1
S3_BUCKET_NAME=

# Comma-free JSON array — must match your frontend's actual dev-server origin(s).
CORS_ALLOW_ORIGINS=["http://localhost:5173"]
