# Copy this file to .env and fill in real values. .env is gitignored.

# "openai" (needs OPENAI_API_KEY + a funded account), "ollama" (free, local, no key needed),
# or "nvidia" (NVIDIA NIM's hosted OpenAI-compatible API, free developer credits).
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...

NVIDIA_API_KEY=nvapi-...

# Only needed if running the backend outside docker-compose (compose sets this itself).
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
