# Copy this file to .env and fill in real values. .env is gitignored.

# "openai" (needs OPENAI_API_KEY + a funded account) or "ollama" (free, local, no key needed).
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...

# Only needed if running the backend outside docker-compose (compose sets this itself).
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
