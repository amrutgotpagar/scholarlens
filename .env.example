# Copy this file to .env and fill in real values. .env is gitignored.

# "openai" (needs OPENAI_API_KEY + a funded account), "ollama" (free, local, no key needed),
# or "nvidia" (NVIDIA NIM's hosted OpenAI-compatible API, free developer credits).
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-...

NVIDIA_API_KEY=nvapi-...

# S3 bucket for uploaded PDFs (see infra/ for the Terraform that provisions it). Credentials
# use boto3's standard env vars — an IAM role would replace these in a real ECS deployment;
# static keys are this build's local-dev equivalent.
AWS_REGION=eu-north-1
S3_BUCKET_NAME=your-bucket-name
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Only needed if running the backend outside docker-compose (compose sets this itself).
DATABASE_URL=postgresql+psycopg://rag:rag@localhost:5432/rag
