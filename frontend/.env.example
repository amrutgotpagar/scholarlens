# Copy to .env.local (gitignored) and fill in.
#
# Supabase Auth. Project Settings -> API in the Supabase dashboard.
# The anon/public key is safe to ship to the browser by design (Supabase's Row Level
# Security is what actually protects data — this project doesn't rely on RLS since the
# backend independently verifies the JWT and scopes every query by owner_id itself).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...
